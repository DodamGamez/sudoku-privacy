      --muted: #5A5678;
      --line: #E6E4F2;
      --accent: #8B86F4;
      --accent-soft: #EEEDFB;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
      line-height: 1.7;
    }

    body {
      padding: 28px 18px 48px;
    }

    .wrap {
      max-width: 720px;
      margin: 0 auto;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 28px 22px 32px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--ink);
    }

    .meta {
      margin: 0 0 24px;
      color: var(--muted);
      font-size: 14px;
    }

    h2 {
      margin: 28px 0 10px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      font-size: 17px;
      font-weight: 800;
      color: #4F4AA8;
    }

    h2:first-of-type {
      border-top: 0;
      padding-top: 0;
    }

    p, li {
      font-size: 15px;
      color: var(--ink);
    }

    p { margin: 0 0 10px; }

    ol, ul {
      margin: 0 0 8px;
      padding-left: 1.2em;
    }

    li { margin: 4px 0; }

    .note {
      background: var(--accent-soft);
      border-radius: 12px;
      padding: 12px 14px;
      color: var(--muted);
      font-size: 14px;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
    }

    .placeholder {
      color: var(--muted);
    }
  </style>
