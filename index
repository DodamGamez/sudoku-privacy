    (function applyPrivacyLinks() {
      const deletionUrl = String(ACCOUNT_DELETION_REQUEST_URL || "").trim();
      const deletionLink = document.getElementById("account-deletion-request-link");
      const deletionLabel = document.getElementById("account-deletion-request-label");

      if (deletionUrl && deletionLink && deletionLabel) {
        deletionLink.href = deletionUrl;
        deletionLink.hidden = false;
        deletionLabel.hidden = true;
      }

